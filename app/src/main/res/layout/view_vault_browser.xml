<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vault_browser_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keepriva_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="28dp">

        <include layout="@layout/view_vault_toolbar" />

        <!-- Removed in Wave C after the dedicated search route is wired. -->
        <EditText
            android:id="@+id/browser_compat_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Search title, username, phone, website or notes"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/keepriva_surface"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Categories"
                        android:textColor="@color/keepriva_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Browse one level at a time."
                        android:textColor="@color/keepriva_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/browser_quick_add"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Add entry or subcategory"
                    android:minWidth="0dp"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/browser_manage_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Manage categories"
                    android:text="Manage"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/browser_breadcrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/keepriva_surface_soft"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="@color/keepriva_primary_dark"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/browser_category_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Subcategories"
                android:textColor="@color/keepriva_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browser_category_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/browser_item_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Items"
                android:textColor="@color/keepriva_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browser_item_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <FrameLayout
                android:id="@+id/browser_empty_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Typed action routes stay visible until Wave C moves them into browser chrome. -->
        <LinearLayout
            android:id="@+id/browser_compat_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/keepriva_surface"
            android:orientation="vertical"
            android:padding="10dp" />
    </LinearLayout>
</ScrollView>
