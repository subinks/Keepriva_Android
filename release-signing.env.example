# Example variable names only. DO NOT put real values in this file and commit them.
# Windows PowerShell example:
# $env:PV_KEYSTORE_FILE="C:\\Secure\\PrivateVault-release.jks"
# $env:PV_KEYSTORE_PASSWORD="<keystore-password>"
# $env:PV_KEY_ALIAS="privatevault"
# $env:PV_KEY_PASSWORD="<key-password>"

PV_KEYSTORE_FILE=
PV_KEYSTORE_PASSWORD=
PV_KEY_ALIAS=
PV_KEY_PASSWORD=

# Optional only when the build system cannot access the keystore.
# 64 hex characters, colons optional when supplied as a Gradle property/environment variable.
PV_EXPECTED_SIGNING_CERT_SHA256=
